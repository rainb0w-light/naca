<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC
    "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
    "https://checkstyle.org/dtds/suppressions_1_2.dtd">
<suppressions>
    <suppress files="[/\\]build[/\\]" checks=".*"/>
    <suppress files="[/\\]src[/\\]main[/\\]translated-java[/\\]" checks=".*"/>
    <!-- Generated CICS programs compile against the historical public CESM field name. -->
    <suppress files="[/\\](OnlineProgram|BatchProgram|CalledProgram)\.java$" checks="MemberName"/>
    <!-- PagingInfo field names are the externally serialized JSON wire contract. -->
    <suppress files="[/\\]jlib[/\\]jslibComp[/\\]PagingInfo\.java$" checks="MemberName"/>
</suppressions>
