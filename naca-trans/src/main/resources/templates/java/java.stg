>>

recursiveCondIsConstant(opposite, zero, space, lowValue, highValue, reference) ::= <<
is<if(opposite)>Not<endif><if(zero)>Zero<elseif(space)>Space<elseif(lowValue)>LowValue<elseif(highValue)>HighValue<endif>(<reference>)
>>

recursiveCondIsConstantEntity(entity) ::= <<
is<if(entity.opposite)>Not<endif><if(entity.zero)>Zero<elseif(entity.space)>Space<elseif(entity.lowValue)>LowValue<elseif(entity.highValue)>HighValue<endif>(<entity.conditionReference>)
>>

