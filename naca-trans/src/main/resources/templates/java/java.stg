group java;

// ============================================================================
//                           CONTROL FLOW TEMPLATES
// ============================================================================

condition(entity) ::= <<
<if(entity.conditionIgnored)><if(entity.shouldRenderElseBlock)>
{
<entity.elseBloc.childrenCode>
}
<endif><else>
if (<entity.condition.codeString>)
{
<entity.thenBloc.childrenCode>}<if(entity.elseBloc)>
else
{
<entity.elseBloc.childrenCode>}<endif><endif>
>>

loop(entity) ::= <<
<if(entity.doBefore)>do
{
<entity.childrenCode>} while (<entity.whileCondition.codeString>);<else>
while (<entity.whileCondition.codeString>)
{
<entity.childrenCode>}<endif>
>>

loopIter(entity) ::= <<
<if(entity.testBefore)><entity.iterations:{iteration | <iterationOpen(iteration)>}; separator="\n"><entity.childrenCode><entity.closingIterations:{iteration | <iterationClose(iteration)>}; separator="\n"><else><iterationInitialize(entity.iterations.first)>
while (true)
{
<entity.childrenCode>if (<entity.iterations.first.condition.codeString>)
{
<iterationUpdate(entity.iterations.first)>}
else
{
break;
}
}<endif>
>>

iterationInitialize(iteration) ::= <<
move(<iteration.initialValue.referenceString>, <iteration.variable.referenceString>);
>>

iterationOpen(iteration) ::= <<
<iterationInitialize(iteration)>
while (<iteration.condition.codeString>)
{
>>

iterationUpdate(iteration) ::= <<
<if(iteration.incrementByOne)>inc(<iteration.variable.referenceString>);
<else><if(iteration.decrementByOne)>dec(<iteration.variable.referenceString>);
<else><if(iteration.step)>inc(<iteration.step.referenceString>, <iteration.variable.referenceString>);
<endif><endif><endif>
>>

iterationClose(iteration) ::= <<
<iterationUpdate(iteration)>}
>>

case(entity) ::= <<
<if(entity.otherwise)><else>if (<entity.condition.codeString>)<endif>
{
<entity.childrenCode>}
>>

caseWhen(whenEntity) ::= <<
case <whenEntity.value.codeString>:
{
<whenEntity.block.childrenCode>
break;
}
>>

// ============================================================================
//                           DATA OPERATION TEMPLATES
// ============================================================================

assign(entity) ::= <<
<if(entity.moveCorresponding)>moveCorresponding(<else><if(entity.fillAll)>moveAll(<else>move(<endif><endif><entity.value.referenceString>, <entity.destinations:{d | <d.referenceString>}; separator=", ">);
>>

addTo(entity) ::= <<
<if(entity.singleValue)><if(entity.increment)>inc(<entity.singleDestination.referenceString>);<else><if(entity.decrement)>dec(<entity.singleDestination.referenceString>);<else>inc(<entity.singleValue.referenceString>, <entity.singleDestination.referenceString>);<endif><endif><else>add(<entity.values:{v | <v.referenceString>}; separator=", ">).<if(entity.rounded)>toRounded<else>to<endif>(<entity.destinations:{d | <d.referenceString>}; separator=", ">);<endif>
>>

subtractTo(entity) ::= <<
subtract(<entity.values:{v | <v.codeString>}; separator=", ">).<if(entity.rounded)>toRounded<else>to<endif>(<entity.destinations:{d | <d.codeString>}; separator=", ">);
>>

multiply(entity) ::= <<
multiply(<entity.value.codeString>, <entity.destination.codeString>).<if(entity.rounded)>toRounded<else>to<endif>(<entity.result.codeString>);
>>

divide(entity) ::= <<
divide(<entity.dividend.referenceString>, <entity.divisor.referenceString>).<if(entity.rounded)>toRounded<else>to<endif>(<entity.result.referenceString><if(entity.remainder)>, <entity.remainder.referenceString><endif>);
>>

compute(entity) ::= <<
<if(entity.onErrorBloc)>if (<entity.calculationDestinations:{d | <computeCheck(entity.expression, d)>}; separator=" || ">)
{
<entity.onErrorBloc.childrenCode>}<else><entity.calculationDestinations:{d | <computeStatement(entity.expression, d)>}; separator="\n"><endif>
>>

computeStatement(expression, destination) ::= <<
compute<if(destination.rounded)>Rounded<endif>(<expression.codeString>, <destination.destination.referenceString>);
>>

computeCheck(expression, destination) ::= <<
compute<if(destination.rounded)>Rounded<endif>(<expression.codeString>, <destination.destination.referenceString>).isError()
>>

assignWithAccessor(entity) ::= <<
<entity.accessorInvocation>;
>>

// ============================================================================
//                           FILE OPERATION TEMPLATES
// ============================================================================

readFile(entity) ::= <<
<if(entity.atEndBloc)>if (<readInvocation(entity)>.atEnd()) {
<entity.atEndBloc.childrenCode>}<if(entity.notAtEndBloc)> else {
<entity.notAtEndBloc.childrenCode>}<endif><else><if(entity.notAtEndBloc)>if (!<readInvocation(entity)>.atEnd()) {
<entity.notAtEndBloc.childrenCode>}<else><readInvocation(entity)> ;<endif><endif>
>>

readInvocation(entity) ::= <<
<if(entity.dataInto)>readInto(<entity.fileDescriptor.referenceString>, <entity.dataInto.referenceString>)<else>read(<entity.fileDescriptor.referenceString>)<endif>
>>

writeFile(entity) ::= <<
<if(entity.dataFrom)>writeFrom(<entity.fileDescriptor.referenceString>, <entity.dataFrom.referenceString>)<else><if(entity.after)>writeAfter(<entity.fileDescriptor.referenceString>, <entity.after.referenceString>)<else>write(<entity.fileDescriptor.referenceString>)<endif><endif>;
>>

openFile(entity) ::= <<
<entity.fileDescriptor.referenceString>.<if(entity.inputMode)>openInput<else><if(entity.outputMode)>openOutput<else><if(entity.inputOutputMode)>openInputOutput<else><if(entity.appendMode)>openExtend<else>open<endif><endif><endif><endif>();
>>

closeFile(entity) ::= <<
<entity.fileDescriptor.referenceString>.close();
>>

// ============================================================================
//                           CONTROL STATEMENTS
// ============================================================================

gotoStatement(entity) ::= <<
goto <entity.reference>;
>>

callFunction(entity) ::= <<
<entity.reference>.execute(<entity.parameters:{p | <p.codeString>}; separator=", ">);
>>

callProgram(entity) ::= <<
<if(entity.hasOnErrorBloc)>if (<endif>call(<entity.callableReference>)<entity.callParameters:{p | .<p.method>(<p.reference.referenceString>)}>.<if(entity.hasOnErrorBloc)>executeCallSafe()) {
<entity.onErrorBloc.childrenCode>}<else>executeCall();<endif>
>>

display(entity) ::= <<
<entity.displayFunction>(<entity.displayItems:{v | <v.expression>}; separator=" + ">);
>>

initialize(entity) ::= <<
initialize(<entity.data.codeString>);
>>

returnStatement(entity) ::= <<
return;
>>

stopRun(entity) ::= <<
stopRun(<entity.stopAllStackCalls>);
>>

exitProgram(entity) ::= <<
exitProgram();
>>

// ============================================================================
//                           ADDITIONAL VERB TEMPLATES
// ============================================================================

accept(entity) ::= <<
<if(entity.fromEnvironmentValue)>acceptEnv(<entity.variable.referenceString>);<else>move(<if(entity.fromDate)>getDateBatch()<else><if(entity.fromDay)>getDayBatch()<else><if(entity.fromDayOfWeek)>getDayOfWeekBatch()<else><if(entity.fromInput)>getInputBatch()<else><if(entity.fromTime)>getTimeBatch()<else><entity.source.referenceString><endif><endif><endif><endif><endif>, <entity.variable.referenceString>);<endif>
>>

count(entity) ::= <<
count(<entity.values:{v | <v.codeString>}; separator=", ">);
>>

exec(entity) ::= <<
<entity.code>;
>>

inspectConverting(entity) ::= <<
inspect(<entity.variable.codeString>).converting(<entity.converting.codeString>);
>>

nextSentence(entity) ::= <<
nextSentence();
>>

parseString(entity) ::= <<
parse(<entity.source.codeString>, <entity.delimiter.codeString>);
>>

replace(entity) ::= <<
replace(<entity.values:{v | <v.codeString>}; separator=", ">);
>>

rewriteFile(entity) ::= <<
rewrite(<entity.file.codeString>);
>>

routineEmulationCall(entity) ::= <<
routineEmulation("<entity.name>");
>>

search(entity) ::= <<
search(<entity.table.codeString>, <entity.condition.codeString>);
>>

setConstant(entity) ::= <<
setConstant(<entity.value.codeString>, <entity.target.codeString>);
>>

sort(entity) ::= <<
sort(<entity.file.codeString>);
>>

sortRelease(entity) ::= <<
sortRelease(<entity.file.codeString>);
>>

sortReturn(entity) ::= <<
sortReturn();
>>

stringConcat(entity) ::= <<
<if(entity.hasOverflowHandler)>if (<endif><entity.concatItems:{item | <stringConcatItem(item)>}; separator=""><if(entity.startIndex)>withPointer(<entity.startIndex.referenceString>).<endif>into(<entity.destination.referenceString>)<if(entity.hasOverflowHandler)>.failed())
{
<entity.childrenCode>}<else>;<endif>
>>

stringConcatItem(item) ::= <<
<if(item.delimiter)>concatDelimitedBy(<item.value.referenceString>, <item.delimiter.referenceString>).<else>concat(<item.value.referenceString>).<endif>
>>

switchCase(entity) ::= <<
<entity.branches:{branch | <switchBranch(branch)>}; separator="\n">
>>

switchBranch(branch) ::= <<
<if(branch.otherwise)><if(branch.continuation)>else
<endif><else><if(branch.continuation)>else <endif>if (<branch.condition.codeString>)
<endif>{
<branch.bodyCode>}
>>

