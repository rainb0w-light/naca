recursiveCICSRetrieveEntity(entity) ::= <<
CESM.retrieve<if(entity.pointer)>Set<else>Into<endif>(<entity.refInto><if(entity.dataLength)>, <entity.dataLength><endif>) ;
>>

// Embedded CICS SET TDQUEUE. Stage 1 resolves the queue reference and OPEN /
