recursiveCICSSetTDQueueEntity(entity) ::= <<
CESM.setTDQueue<if(entity.open)>Open<else>Closed<endif>(<entity.queueName>) ;
>>

// Embedded CICS START. Stage 1 resolves TRANSID and all optional operands; ST4
// only selects the verified class-literal form and formats the fluent call.
recursiveCICSStartEntity(entity) ::= <<
CESM.start(<if(entity.verified)><entity.transIDConstantValue>.class<else><entity.transID><endif>)<if(entity.interval)>.interval(<entity.interval>)<elseif(entity.time)>.time(<entity.time>)<endif><if(entity.termID)>.termID(<entity.termID>)<endif><if(entity.sysID)>.sysID(<entity.sysID>)<endif><if(entity.dataFrom)>.dataFrom(<entity.dataFrom><if(entity.dataLength)>, <entity.dataLength><endif>)<endif>.doStart() ;
>>

recursiveCICSStartBrowseEntity(entity) ::= <<
CESM.startBrowseDataSet(<entity.dataSet>)<if(entity.recIDField)>.recIDField(<entity.recIDField>)<endif><if(entity.keyLength)>.keyLength(<entity.keyLength>)<endif><if(entity.GTEQ)>.gTEQ()<endif> ;
>>

recursiveCICSWriteEntity(entity) ::= <<
<if(entity.writeStatistics)><recursiveCICSWriteStatistics(entity)><else>CESM.write<if(entity.writeToDataSet)>DataSet<else>File<endif>(<entity.name>).from(<entity.dataFrom><if(entity.dataLength)>, <entity.dataLength><endif>)<if(entity.recIDField)>.recIDField(<entity.recIDField>)<endif><if(entity.keyLength)>.keyLength(<entity.keyLength>)<endif> ;<endif>
>>

recursiveCICSWriteStatistics(entity) ::= "Pub2000Routines.writeStatistics(getProgramManager(), <entity.dataFromOwner>) ;"

recursiveCICSWriteQEntity(entity) ::= <<
CESM.write<if(entity.persistent)>Transiant<else>Temp<endif>Queue(<entity.queueName><if(entity.rewrite)>, <entity.item><endif>).from(<entity.dataRef><if(entity.dataLength)>, <entity.dataLength><endif>)<if(entity.itemOutput)>.item(<entity.item>)<endif><if(entity.numItem)>.numItem(<entity.numItem>)<endif><if(entity.main)>.main()<elseif(entity.auxiliary)>.auxiliary()<endif><if(entity.sysID)>.sysID(<entity.sysID>)<endif> ;
>>

// Embedded CICS HANDLE AID (EXEC CICS HANDLE AID ENTER(label) PF1(label) ...
// ANYKEY(label) END-EXEC). Emits one CESM.handleAID(<cond>, <label>) per
// handled AID entry and one CESM.unhandleAID(<cond>) per unhandled AID entry.
// Mirrors CJavaCICSHandleAID.DoExport exactly: handled AIDs output first (in
// parser insertion order), then unhandled AIDs, each on its own line and
// terminated by " ;". An entity with no handled and no unhandled AIDs is
// filtered by the assembler's ignore()-based active-children selection (the
// template receives an empty iteration, producing no output).
recursiveCICSHandleAIDEntity(entity) ::= <<
<entity.handledAIDEntries:{entry | CESM.handleAID("<entry.condition>", <entry.label; format="javaFormattedName">) ;}; separator="\n">
<if(entity.handledAIDEntries)><if(entity.unhandledAIDEntries)>
<endif><endif><entity.unhandledAIDEntries:{entry | CESM.unhandleAID("<entry.condition>") ;}; separator="\n">
>>

recursiveAcceptEntity(entity) ::= <<
