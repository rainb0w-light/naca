<entity.thenBloc>
}<if(entity.elseBloc)>
else {
<entity.elseBloc>
}<endif><endif><endif>
>>

recursiveLoopWhile(doBefore, condition, body) ::= <<
<if(doBefore)>do {
<body; separator="\n">
}
while (<condition>) ;<else>while (<condition>) {
<body; separator="\n">
}<endif>
>>

recursiveLoopWhileEntity(entity) ::= <<
