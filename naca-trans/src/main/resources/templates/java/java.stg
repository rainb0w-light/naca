group java;

// ============================================================================
//                           CONTROL FLOW TEMPLATES
// ============================================================================

condition(entity) ::= <<
<if(entity.conditionIgnored)><if(entity.shouldRenderElseBlock)>
{
<entity.elseBloc.childrenCode>
}
<endif><else>
if (<entity.condition.codeString>)
{
<entity.thenBloc.childrenCode>
}<if(entity.elseBloc)>
else
{
<entity.elseBloc.childrenCode>
}<endif><endif>
>>

loop(entity) ::= <<
<if(entity.doBefore)>do
{
<entity.childrenCode>
} while (<entity.whileCondition.codeString>);<else>
while (<entity.whileCondition.codeString>)
{
<entity.childrenCode>
}<endif>
>>

loopIter(entity) ::= <<
for (<entity.loopVariable.codeString> = <entity.fromValue.codeString>; <entity.loopVariable.codeString> \<= <entity.toValue.codeString>; <entity.loopVariable.codeString> += <entity.stepValue.codeString>)
{
<entity.childrenCode>
}
>>

case(entity) ::= <<
switch (<entity.caseValue.codeString>)
{
<entity.caseWhens:caseWhen()>
<if(entity.caseOtherwise)>default:
{
<entity.caseOtherwise.childrenCode>
}<endif>
}
>>

caseWhen(whenEntity) ::= <<
case <whenEntity.value.codeString>:
{
<whenEntity.block.childrenCode>
break;
}
>>

// ============================================================================
//                           DATA OPERATION TEMPLATES
// ============================================================================

assign(entity) ::= <<
<if(entity.moveCorresponding)>moveCorresponding(<else><if(entity.fillAll)>moveAll(<else>move(<endif><endif><entity.value.codeString>, <entity.destinations:{d | <d.codeString>}; separator=", ">);
>>

addTo(entity) ::= <<
<if(entity.singleValue)><if(entity.isIncrement)>inc(<entity.singleDestination.codeString>);<else><if(entity.isDecrement)>dec(<entity.singleDestination.codeString>);<else>inc(<entity.singleValue.codeString>, <entity.singleDestination.codeString>);<endif><endif><else>add(<entity.values:{v | <v.codeString>}; separator=", ">).<if(entity.rounded)>toRounded<else>to<endif>(<entity.destinations:{d | <d.codeString>}; separator=", ">);<endif>
>>

subtractTo(entity) ::= <<
subtract(<entity.values:{v | <v.codeString>}; separator=", ">).<if(entity.rounded)>toRounded<else>to<endif>(<entity.destinations:{d | <d.codeString>}; separator=", ">);
>>

multiply(entity) ::= <<
multiply(<entity.value.codeString>, <entity.destination.codeString>).<if(entity.rounded)>toRounded<else>to<endif>(<entity.result.codeString>);
>>

divide(entity) ::= <<
divide(<entity.value.codeString>, <entity.divisor.codeString>).<if(entity.rounded)>toRounded<else>to<endif>(<entity.result.codeString>);
>>

compute(entity) ::= <<
<entity.result.codeString> = <entity.expression.codeString>;
>>

assignWithAccessor(entity) ::= <<
<entity.accessorInvocation>;
>>

// ============================================================================
//                           FILE OPERATION TEMPLATES
// ============================================================================

readFile(entity) ::= <<
read(<entity.fileDescriptor.codeString>, <entity.dataInto.codeString>)<if(entity.atEndBloc)>.atEnd(() -\> {
<entity.atEndBloc.childrenCode>
})<endif><if(entity.notAtEndBloc)>.notAtEnd(() -\> {
<entity.notAtEndBloc.childrenCode>
})<endif>;
>>

writeFile(entity) ::= <<
write(<entity.fileDescriptor.codeString>, <entity.dataFrom.codeString>);
>>

openFile(entity) ::= <<
open(<entity.fileDescriptor.codeString>, "<entity.openMode>");
>>

closeFile(entity) ::= <<
close(<entity.fileDescriptor.codeString>);
>>

// ============================================================================
//                           CONTROL STATEMENTS
// ============================================================================

gotoStatement(entity) ::= <<
goto <entity.reference>;
>>

callFunction(entity) ::= <<
<entity.reference>.execute(<entity.parameters:{p | <p.codeString>}; separator=", ">);
>>

callProgram(entity) ::= <<
call("<entity.reference.codeString>");
>>

display(entity) ::= <<
display(<entity.values:{v | <v.codeString>}; separator=", ">);
>>

initialize(entity) ::= <<
initialize(<entity.data.codeString>);
>>

returnStatement(entity) ::= <<
return;
>>

// ============================================================================
//                           DATA STRUCTURE TEMPLATES
// ============================================================================

structure(entity) ::= <<
Var <entity.formattedName> = declare.level(<entity.level>)<if(entity.redefines)>.redefines(<entity.redefines.codeString>)<endif><if(entity.occurs)>.occurs(<entity.occurs.codeString>)<endif>.<entity.type>(<entity.length><if(entity.decimals)>, <entity.decimals><endif>)<if(entity.comp3)>.comp3()<endif><if(entity.comp)>.comp()<endif><if(entity.value)>.value(<entity.value.codeString>)<endif><if(entity.filler)>.filler()<else>.var()<endif>;
>>

dataSection(entity) ::= <<
// <entity.sectionName> Section
>>

// ============================================================================
//                           EXPRESSION TEMPLATES
// Note: Expression templates use boolean flags pushed from controller
// instead of value comparison (ST4 does not support <if(a == "x")>)
// ============================================================================

exprSum(entity) ::= <<
<if(entity.isAdd)>add(<entity.left.codeString>, <entity.right.codeString>)<else>subtract(<entity.left.codeString>, <entity.right.codeString>)<endif>
>>

exprProd(entity) ::= <<
<if(entity.isMultiply)>multiply(<entity.left.codeString>, <entity.right.codeString>)<else>divide(<entity.left.codeString>, <entity.right.codeString>)<endif>
>>

condOr(entity) ::= <<
(<entity.left.codeString> || <entity.right.codeString>)
>>

condAnd(entity) ::= <<
(<entity.left.codeString> && <entity.right.codeString>)
>>

condNot(entity) ::= <<
!<entity.operand.codeString>
>>

condCompare(entity) ::= <<
(<entity.left.codeString> <entity.operator> <entity.right.codeString>)
>>

condEquals(entity) ::= <<
<entity.left.codeString>.equals(<entity.right.codeString>)
>>

// ==================== Utility Templates (merged from base.stg) ====================

nullCheck(value, defaultValue) ::= <<
<if(value)><value><else><defaultValue><endif>
>>

formatName(name) ::= <<
<name>
>>

dataRef(entity) ::= <<
<if(entity.ofQualifier)><entity.ofQualifier.formattedName>.<endif><entity.formattedName>
>>

continueStatement(entity) ::= "continue;"
breakStatement(entity) ::= "break;"