structure(entity) ::= <<
Var <entity.formattedName> = declare.level(<entity.level>)<if(entity.redefines)>.redefines(<entity.redefines.codeString>)<endif><if(entity.occurs)>.occurs(<entity.occurs.codeString>)<endif><if(entity.type)>.<entity.type>(<entity.length><if(entity.decimals)>, <entity.decimals><endif>)<endif><if(entity.comp3)>.comp3()<endif><if(entity.comp)>.comp()<endif><if(entity.value)>.value(<entity.value.codeString>)<endif><if(entity.filler)>.filler()<else>.var()<endif>;
>>

dataSection(entity) ::= <<
// <entity.sectionName> Section
>>

